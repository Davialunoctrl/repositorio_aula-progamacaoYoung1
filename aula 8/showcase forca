import random

palavras = [
    "python",
    "computador",
    "programacao",
    "internet",
    "teclado",
    "elefante",
    "brasil",
    "futebol",
    "abacaxi"
]

palavra = random.choice(palavras)
letras_corretas = []
letras_erradas = []
tentativas = 6

print("========================")
print("     JOGO DA FORCA")
print("========================")

while tentativas > 0:

    print("\nPalavra:", end=" ")

    for letra in palavra:
        if letra in letras_corretas:
            print(letra, end=" ")
        else:
            print("_", end=" ")

    print("\nTentativas restantes:", tentativas)
    print("Letras erradas:", letras_erradas)

    chute = input("\nDigite uma letra: ").lower().strip()

    if len(chute) != 1 or not chute.isalpha():
        print("Digite apenas uma letra!")
        continue

    if chute in letras_corretas or chute in letras_erradas:
        print("Você já tentou essa letra!")
        continue

    if chute in palavra:
        letras_corretas.append(chute)
        print("Muito bem! Você acertou!")
    else:
        letras_erradas.append(chute)
        tentativas -= 1
        print("Ops! Você errou!")

    if all(letra in letras_corretas for letra in palavra):
        print("\nPARABÉNS! Você venceu!")
        print("A palavra era:", palavra)
        break

else:
    print("\nGAME OVER!")
    print("A palavra era:", palavra)

print("\nObrigado por jogar!")
